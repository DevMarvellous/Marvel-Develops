# Copy this file to .env.local and fill in your own values.
# All of these are server-only — none are ever sent to the browser.

# Google Gemini — powers the AI assistant (Otto) and the AI Project Planner.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# Email — Gmail SMTP (temporary until marveldevelops.com is verified on Resend)
# 1. Make sure 2-Step Verification is ON for your Google account
# 2. Go to myaccount.google.com/apppasswords → create an App Password → copy the 16-char code
GMAIL_USER=marvellousadepoju79@gmail.com
GMAIL_APP_PASSWORD=your_16_character_app_password
ADMIN_NOTIFICATION_EMAIL=marvellousadepoju79@gmail.com

# --- Switch back to Resend once marveldevelops.com domain is verified ---
# RESEND_API_KEY=your_resend_api_key
# RESEND_FROM_EMAIL="Marvel Develops <notifications@marveldevelops.com>"
# Then rewrite lib/server/email.ts to use the Resend client (see git history).

# Admin panel — protects /admin. Set to any password you choose.
ADMIN_PASSWORD=your_admin_password
