# Copy this file to .env.local and fill in your own values.
# All of these are server-only — none are ever sent to the browser.

# Google Gemini — powers the AI assistant (Otto) and the AI Project Planner.
# https://aistudio.google.com/apikey
GEMINI_API_KEY=your_gemini_api_key

# Supabase — stores contact form + AI planner submissions, and admin login.
# https://supabase.com — create a project, then Settings → API for these.
SUPABASE_URL=your_supabase_project_url
SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key

# Resend — sends the immediate admin lead notification + the 10-minute
# customer follow-up. https://resend.com
RESEND_API_KEY=your_resend_api_key
RESEND_FROM_EMAIL="Outends <notifications@outends.com>"
ADMIN_NOTIFICATION_EMAIL=hello@outends.com
